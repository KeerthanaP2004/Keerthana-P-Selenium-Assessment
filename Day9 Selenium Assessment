	public void executor(String keyword)
	{
		if(keyword.equals("LAUNCH_BROWSER"))
		{
			s.launchbrowser();
		}
		else if(keyword.equals("OPEN_URL"))
		{
			s.openurl();
		}
		else if(keyword.equals("USERNAME"))
		{
			s.Username();
		}
		else if(keyword.equals("PASSWORD"))
		{
			s.Password();
		}
		else if(keyword.equals("LOGIN"))
		{
			s.Login();
		}
	}
}


