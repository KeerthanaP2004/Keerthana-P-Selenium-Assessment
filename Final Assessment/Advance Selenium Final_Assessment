package POM;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;

import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;

import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class OrangeHRMApplBuzzPage_Assessment2 {
    WebDriver driver;
    WebDriverWait wait;

    public OrangeHRMApplBuzzPage_Assessment2(WebDriver driver) {
        this.driver = driver;
        PageFactory.initElements(driver, this);
        wait = new WebDriverWait(driver,Duration.ofSeconds(10));
    }

    @FindBy(xpath = "//span[text()='Buzz']")
    private WebElement buzzLink;

    @FindBy(xpath = "//textarea")
    private WebElement postTextArea;

    @FindBy(xpath = "//button[normalize-space()='Post']")
    private WebElement postButton;

    public void clickBuzz() {
        wait.until(ExpectedConditions.elementToBeClickable(buzzLink));
        buzzLink.click();
    }

    public void enterPost(String value) {
        wait.until(ExpectedConditions.visibilityOf(postTextArea));
        postTextArea.sendKeys(value);
    }

    public void clickPost() {
        wait.until(ExpectedConditions.elementToBeClickable(postButton));
        postButton.click();
    }

    public boolean verifyPost(String value) {
        By recentPost =By.xpath("//p[contains(normalize-space(),'"+ value + "')]");
        try {
            WebElement post =wait.until(ExpectedConditions.visibilityOfElementLocated(recentPost));
            return post.isDisplayed();
        } catch (Exception e) {
            return false;
        }
    }
}

