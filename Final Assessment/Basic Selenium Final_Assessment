package FinalAssessment;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;

public class DemoAppQSSliderPage_Task2 {

    public static void main(String[] args) throws InterruptedException {

        WebDriver driver = new ChromeDriver();

        driver.manage().window().maximize();

        driver.get("https://demoapps.qspiders.com/ui/slider?sublist=0");

        Thread.sleep(2000);

        // Locate slider
        WebElement slider =
                driver.findElement(By.xpath("//input[@type='range']"));

        // Create Actions object
        Actions action = new Actions(driver);

        // Move slider to the right
        action.dragAndDropBy(slider, 200, 0).perform();

        Thread.sleep(2000);

        System.out.println("Slider moved successfully");
        
        //Verify Men Cotton Jacket
        String product = driver.findElement(By.xpath("(//h3[@class='text-sm font-bold pb-1'])[3]")).getText();
        System.out.println(product);

        if (product.equals("Mens Cotton Jacket...")) {
            System.out.println("Mens Cotton Jacket is displayed");
        } else {
            System.out.println("Mens Cotton Jacket is not displayed");
        }
        driver.quit();
    }
}

