//		System.out.println("Save button clicked");
//		Thread.sleep(3000);

		// SEARCH CANDIDATE
		// Select Job Title
		search.getJobTitle(JobTitle);
		System.out.println("Job Title selected");

		// Select Vacancy
		search.getJobVacancySearch(Vacancy);
		System.out.println("Vacancy selected in search");

