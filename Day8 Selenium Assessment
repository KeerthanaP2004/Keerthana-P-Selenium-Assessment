		candidate.getDateFrom(ApplicationDate);
		candidate.getDateTo(ApplicationDate);
		System.out.println("Application date entered");

		// CANDIDATES
		// Click Candidates
	    recruitment.getCandidates();
	    System.out.println("Candidates clicked");
