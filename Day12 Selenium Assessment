package UsingTestNG;

import java.io.FileInputStream;

import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;
import org.testng.Assert;
import org.testng.annotations.Test;

import BaseClassUtility.OrangeHRMApplBaseClass_TC9;
import POM.OrangeHRMApplLoginPage_TC9;
import POM.OrangeHRMApplMyInfoPage_TC9;

public class OrangeHRMApplImplementation_TC9 extends OrangeHRMApplBaseClass_TC9 {

    @Test
    public void editEmployeeDetailsTest() throws Exception {
        // Read employee details from Excel
        FileInputStream fis = new FileInputStream("./src/test/resources/DDT/OrangeHRMAppl_TC9.xlsx");
        Workbook workbook = WorkbookFactory.create(fis);
        
        String firstName = workbook.getSheet("Sheet1").getRow(1).getCell(0).getStringCellValue();
        String lastName = workbook.getSheet("Sheet1").getRow(1).getCell(1).getStringCellValue();
        String employeeId = String.valueOf((long) workbook.getSheet("Sheet1").getRow(1).getCell(2).getNumericCellValue());

        System.out.println("First Name = " + firstName); 
        System.out.println("Last Name = " + lastName); 
        System.out.println("Employee ID = " + employeeId);
        
        workbook.close();
        fis.close();
        
        // Create MyInfo POM object
        OrangeHRMApplMyInfoPage_TC9 myInfo = new OrangeHRMApplMyInfoPage_TC9(driver);

        // Click My Info
        myInfo.clickMyInfo();

        // Edit First Name
        myInfo.enterFirstName(firstName);

        // Edit Last Name
        myInfo.enterLastName(lastName);

        // Edit Employee ID
        myInfo.enterEmployeeId(employeeId);

        // Click Save
        myInfo.clickSave();
        System.out.println("Employee details updated successfully");

        // Logout
        myInfo.clickUserDropdown();
        myInfo.clickLogout();
        System.out.println("Logout successful");

        // Login again
        driver.get(p.getProperty("Url"));
        OrangeHRMApplLoginPage_TC9 login = new OrangeHRMApplLoginPage_TC9(driver);
        login.enterUsername(p.getProperty("Username"));
        login.enterPassword(p.getProperty("Password"));
        login.clickLogin();

        System.out.println("Login successful");
        Thread.sleep(2000);

        // Click My Info again
        OrangeHRMApplMyInfoPage_TC9 myInfo2 = new OrangeHRMApplMyInfoPage_TC9(driver); 
        myInfo2.clickMyInfo();
        Thread.sleep(2000);

        // Verify First Name
        Assert.assertEquals( myInfo2.getFirstName(), firstName, "First Name is not updated");

        // Verify Last Name
        Assert.assertEquals( myInfo2.getLastName(), lastName, "Last Name is not updated");

        // Verify Employee ID
        Assert.assertEquals( myInfo2.getEmployeeId(), employeeId, "Employee ID is not updated");
        System.out.println("Employee details verified successfully");

        // Logout
        myInfo2.clickUserDropdown();
        myInfo2.clickLogout();
        System.out.println("Logout completed");
    }
}
