package UsingTestNG;

import java.io.FileInputStream;

import org.apache.poi.ss.usermodel.Row;
import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;

import org.testng.annotations.Test;
import BaseClassUtility.OrangeHRMApplBaseClass_TC8;
import POM.OrangeHRMApplRecruitmentPage_TC8;
import POM.OrangeHRMApplVacancyPage_TC8;

public class OrangeHRMApplImplementation_TC8
        extends OrangeHRMApplBaseClass_TC8 {

    @Test
    public void createVacancyTest() throws Exception {
        FileInputStream fis = new FileInputStream("./src/test/resources/DDT/OrangeHRMAppl_TC8.xlsx");
        Workbook workbook = WorkbookFactory.create(fis);
        Sheet sheet = workbook.getSheet("Sheet1");
        Row row = sheet.getRow(1);

        String vacancyName = row.getCell(0).getStringCellValue();
        String jobTitle = row.getCell(1).getStringCellValue();
        String description = row.getCell(2).getStringCellValue();
        String hiringManager = row.getCell(3).getStringCellValue();
        String numberOfPositions = String.valueOf((int) row.getCell(4).getNumericCellValue());

        OrangeHRMApplRecruitmentPage_TC8 recruitment = new OrangeHRMApplRecruitmentPage_TC8(driver);
        recruitment.clickRecruitment();
        recruitment.clickVacancies();
        Thread.sleep(2000); 
   
        recruitment.clickAdd();
        Thread.sleep(2000);

        OrangeHRMApplVacancyPage_TC8 vacancy = new OrangeHRMApplVacancyPage_TC8(driver);
        vacancy.enterVacancyName(vacancyName);
        vacancy.selectJobTitle(jobTitle);
        vacancy.enterDescription(description);
        vacancy.selectHiringManager(hiringManager);
        vacancy.enterNumberOfPositions(numberOfPositions);
        vacancy.clickSave();
        
        workbook.close();
        fis.close();
    }
}
