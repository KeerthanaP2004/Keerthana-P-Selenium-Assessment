package POM;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;

import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;

public class OrangeHRMApplVacancyPage_TC8 {
    WebDriver driver;

    public OrangeHRMApplVacancyPage_TC8(WebDriver driver) {
        this.driver = driver;
        PageFactory.initElements(driver, this);
    }

    @FindBy(xpath = "//label[text()='Vacancy Name']/../..//input")
    private WebElement vacancyName;

    @FindBy(xpath = "//label[text()='Job Title']/../..//div[contains(@class,'oxd-select-text')]")
    private WebElement jobTitleDropdown;

    @FindBy(xpath = "//textarea")
    private WebElement description;

    @FindBy(xpath = "//label[text()='Hiring Manager']/../..//input")
    private WebElement hiringManager;

    @FindBy(xpath = "//label[text()='Number of Positions']/../..//input")
    private WebElement numberOfPositions;

    @FindBy(xpath = "//button[normalize-space()='Save']")
    private WebElement saveButton;

    public void enterVacancyName(String value) {
        vacancyName.sendKeys(value);
    }

    public void selectJobTitle(String value) {
        jobTitleDropdown.click();
        WebElement jobTitle = driver.findElement(By.xpath("//div[@role='option']//span[normalize-space()='" + value + "']"));
        jobTitle.click();
    }

    public void enterDescription(String value) {
        description.sendKeys(value);
    }

    public void selectHiringManager(String value) throws Exception {
        hiringManager.sendKeys(value);
        Thread.sleep(2000);
        WebElement manager = driver.findElement(By.xpath("//div[@role='option'][contains(.,'" + value + "')]"));
        manager.click();
    } 

    public void enterNumberOfPositions(String value) {
        numberOfPositions.sendKeys(value);
    }

    public void clickSave() {
        saveButton.click();
    }
}

